{
  "name": "PengYueJuPlus",
  "version": "3.0.0",
  "private": true,
  "description": "芃悦居铝木门",
  "author": "dingshirong",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "node tools/dev.cjs",
    "build": "vue-tsc --noEmit && vite build",
    "build:dir": "node tools/package.cjs --installer",
    "dist": "node tools/package.cjs --installer",
    "test": "tsx --test tests/*.test.ts && node tools/electron-node.cjs tests/storage.cjs && node tools/electron-node.cjs tests/recent-inputs.cjs && node tools/electron-node.cjs tests/batch-delete.cjs",
    "benchmark": "node tools/electron-node.cjs tools/benchmark.cjs",
    "typecheck": "vue-tsc --noEmit",
    "postinstall": "node tools/prepare-native.cjs",
    "test:e2e": "npm run build && node tests/electron.cjs && node tests/history-batch-delete.cjs && node tests/recent-inputs-ui.cjs && node tests/stale-preload.cjs && node tests/stale-preload.cjs --old-main && node tests/documents.cjs && node tests/print.cjs"
  },
  "dependencies": {
    "better-sqlite3": "8.7.0",
    "vue": "3.5.13",
    "element-plus": "2.9.5",
    "nedb": "1.8.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "5.2.3",
    "vite": "6.2.6",
    "typescript": "5.8.3",
    "vue-tsc": "2.2.8",
    "tsx": "4.19.3",
    "@types/node": "22.14.0",
    "electron": "22.3.27",
    "electron-builder": "24.13.3",
    "@playwright/test": "1.51.1"
  },
  "build": {
    "appId": "com.pengyueju.lvmumen",
    "productName": "PengYueJuPlus",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "desktop/**",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/**"
    ],
    "win": {
      "icon": "build/icons/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    },
    "electronDist": "node_modules/electron/dist"
  }
}
